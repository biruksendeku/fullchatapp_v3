<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title> Chat App </title>
  <link rel="stylesheet" href="/css/service.css" />
</head>
<body>
  <main class="main">
    <!-- PART 2 -->
    <div id="msgs">
    
    	<% if(conversations.length !== 0) { %>
    		<% conversations.forEach(conv => { %>
    			<div class="div-quest div-quest-ans"> <p class="quest-para"> <%= conv.question %> </p> </div>
    			<div class="div-ans div-quest-ans"> <p class="ans-para"> <%= conv.answer %> </p> </div>
    		<% }) %>
    	<% }else { %>
    		<div class="div-quest div-quest-ans"> <p class="quest-para"> Your question would be here! </p> </div>
    		<div class="div-ans div-quest-ans"> <p class="ans-para"> AI response would be here! </p> </div>
    	<% } %>
    	
    </div>
    
    <!-- PART 1 -->
    <div class="inputDiv">
      <!-- form handler 1 -->
      <div id="div1" class="divs">
        <form class="forms" id="form1">
          <label id="label1" for="message"> Message: </label>
          <input type="text" id="message" name="message" />
          <input type="submit" id="btn1" class="btns" value="Message" />
        </form>
      </div>
      <!-- form handler 2 -->
      <div id="div2" class="divs">
        <!--<form class="forms" id="form2">
          <label id="label2" for="room"> Room: </label>
          <input type="text" id="room" name="room" />
          <input type="submit" id="btn2" class="btns" value="Join" />
        </form>-->
        <button id="btn2" class="btns" type="button"> Disconnect </button>
      </div>
    </div>
  </main>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/service.js"></script>

</body>
</html>
