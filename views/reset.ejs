<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Reset Password</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/reset.css">
</head>
<body>
  <section class="form__section">
    <form action="/api/reset/password" class="form" method="post" id="resetForm">
      <div class="logo">
        <i class="fas fa-key"></i>
      </div>
      <h1 class="form-title">Reset Password</h1>

      <div class="reset-msg">
        <h3><i class="fas fa-envelope"></i> Reset Email Will Be Sent</h3>
        <p>Please check your spam folder if you don't see it within 5 minutes.</p>
      </div>

      <% if(error && error.length > 0) { %>
        <div class="alert-error"> 
          <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
      <% } else if(success && success.length > 0) { %>
        <div class="alert-success"> 
          <i class="fas fa-check-circle"></i> <%= success %>
        </div>
      <% } else { %>
        <div class="alert-error" style="display: none;"></div>
        <div class="alert-success" style="display: none;"></div>
      <% } %>

      <div class="divs">
        <label class="labels" for="email">
          <i class="fas fa-envelope"></i> Email Address
        </label>
        <div class="input-wrapper">
          <div class="input-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <input type="email" id="email" class="inputs-class" name="email" required autocomplete="email" placeholder="Enter your registered email" autofocus />
        </div>
      </div>

      <div class="divs">
        <label class="labels" for="newPassword">
          <i class="fas fa-lock"></i> New Password
        </label>
        <div class="input-wrapper">
          <div class="input-icon">
            <i class="fas fa-lock"></i>
          </div>
          <input type="password" id="newPassword" class="inputs-class" name="newPassword" required placeholder="Enter your new password" />
          <button id="show-btn" type="button" class="password-toggle" aria-label="Show password">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <button id="btn" class="btn" type="submit">
        <i class="fas fa-paper-plane"></i> Send Reset Email
      </button>
      
      <div class="div__msg">
        Remember your password? 
        <a href="/login"><i class="fas fa-sign-in-alt"></i> Go back to Login</a>
      </div>
    </form>
  </section>

  <script src="/js/reset.js"></script>
</body>
</html>
